# Copy to .env and adjust. Every value is optional.
# Keep comments on their own lines: Docker Compose reads "KEY=   # note" as the value "# note".
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000

# ---- Free-usage limits shown to users ----
MAX_PROJECT_SECONDS=3600
STORAGE_QUOTA_MB=5120
DAILY_RENDER_SECONDS=3600      # per user per 24 h on a shared server; ignored when SELF_HOSTED=true
MAX_UPLOAD_MB=200
SELF_HOSTED=false

# ---- Script / storyboard writer (auto picks the first available) ----
LLM_PROVIDER=auto              # auto | ollama | huggingface | template
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
# Free Hugging Face token: enables HF text + image models (rate-limited). Leave empty to disable.
HF_TOKEN=
HF_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# ---- Your own GPU via ComfyUI ----
# Address of your ComfyUI, e.g. http://host.docker.internal:8188. Leave empty to disable.
COMFYUI_URL=
COMFYUI_IMAGE_WORKFLOW=/workflows/sdxl_image.json
# Set to /workflows/svd_img2vid.json to animate scenes with Stable Video Diffusion.
COMFYUI_VIDEO_WORKFLOW=

# ---- Voices ----
PIPER_VOICES_DIR=/voices       # put Piper .onnx voices here (e.g. en_US-amy-medium, sw_CD-lanfrica-medium)
WHISPER_MODEL=base

# ---- Optional Supabase auth (accept Supabase access tokens) ----
SUPABASE_JWT_SECRET=
