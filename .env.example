# Copy to .env and adjust. Every value is optional.
# Keep comments on their own lines: Docker Compose reads "KEY=   # note" as the value "# note".
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000

# ---- Putting the app online ----
# Invite code people must type to create an account. Set this before sharing a public link,
# otherwise anyone who finds the link can sign up and use your computer to make videos.
SIGNUP_CODE=
# On a server with your own domain name (e.g. luvakule.com), put it here for automatic HTTPS.
# SITE_ADDRESS=luvakule.com

# ---- Free-usage limits shown to users ----
MAX_PROJECT_SECONDS=3600
STORAGE_QUOTA_MB=5120
# Rendered seconds per user per 24 h on a shared server; ignored when SELF_HOSTED=true.
DAILY_RENDER_SECONDS=3600
MAX_UPLOAD_MB=200
SELF_HOSTED=false

# ---- Script / storyboard writer (auto picks the first available) ----
# auto | ollama | gemini | huggingface | template
LLM_PROVIDER=auto
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
# Free Google AI Studio key (https://aistudio.google.com/apikey): Gemini writes the storyboard
# and describes a picture for each scene. Free tier, rate-limited; Google may use free-tier
# content to improve its products. Leave empty to disable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Free Hugging Face token: enables HF text + image models (rate-limited). Leave empty to disable.
HF_TOKEN=
HF_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# ---- AI pictures for each scene ----
# Pollinations: free, no account. Scene picture descriptions are sent to pollinations.ai.
# About one picture per 15 seconds. Set to false to keep everything on this machine.
POLLINATIONS=true
POLLINATIONS_MODEL=flux

# ---- Your own GPU via ComfyUI ----
# Address of your ComfyUI, e.g. http://host.docker.internal:8188. Leave empty to disable.
COMFYUI_URL=
COMFYUI_IMAGE_WORKFLOW=/workflows/sdxl_image.json
# Set to /workflows/svd_img2vid.json to animate scenes with Stable Video Diffusion.
COMFYUI_VIDEO_WORKFLOW=

# ---- Voices ----
# Natural narrator voices (Piper) are downloaded once into this folder on first use.
# You can also put any Piper .onnx + .onnx.json voice pair here yourself.
PIPER_VOICES_DIR=/voices
PIPER_AUTO_DOWNLOAD=true
# Optional: choose another Piper voice for a language and gender, e.g.
# PIPER_VOICE_EN_MALE=en_US-ryan-high
# (check the voice's licence first: ryan and hfc_* are for non-commercial use only)
WHISPER_MODEL=base

# ---- Optional Supabase auth (accept Supabase access tokens) ----
SUPABASE_JWT_SECRET=
